@page "/Login/ResetPassword"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@{
    ViewData["Title"] = "Resetear Contrasena";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <h2 class="mb-3">Resetear contrasena</h2>
                <p class="text-muted mb-4">
                    Seleccione el usuario, escriba la nueva contrasena y confirme el cambio.
                </p>

                <form id="resetPasswordForm">
                    <div class="mb-3">
                        <label for="busquedaUsuario" class="form-label">Buscar usuario</label>
                        <input type="text" class="form-control" id="busquedaUsuario" placeholder="Escriba para filtrar usuarios" />
                    </div>

                    <div class="mb-3">
                        <label for="usuarioId" class="form-label">Usuario</label>
                        <select class="form-select" id="usuarioId" required>
                            <option value="">Seleccione un usuario</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="nuevaPassword" class="form-label">Nueva contrasena</label>
                        <input type="password" class="form-control" id="nuevaPassword" minlength="6" required />
                    </div>

                    <div class="mb-3">
                        <label for="confirmarPassword" class="form-label">Confirmar contrasena</label>
                        <input type="password" class="form-control" id="confirmarPassword" minlength="6" required />
                    </div>

                    <button type="submit" class="btn btn-primary">Actualizar contrasena</button>
                </form>

                <div id="responseMessage" class="alert d-none mt-4 mb-0"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            const token = localStorage.getItem('token');
            let usuarios = [];

            function fetchWithToken(url, options) {
                options = options || {};
                options.headers = options.headers || {};
                options.headers['Authorization'] = 'Bearer ' + token;
                return fetch(url, options);
            }

            function mostrarMensaje(esExito, mensaje) {
                $('#responseMessage')
                    .removeClass('d-none alert-success alert-danger')
                    .addClass(esExito ? 'alert-success' : 'alert-danger')
                    .text(mensaje);
            }

            function renderUsuarios(filtro) {
                const texto = (filtro || '').trim().toLowerCase();
                const coincidencias = usuarios.filter(function (usuario) {
                    return usuario.nombreUsuario.toLowerCase().includes(texto);
                });

                const select = $('#usuarioId');
                const valorActual = select.val();
                select.empty();
                select.append('<option value="">Seleccione un usuario</option>');

                coincidencias.forEach(function (usuario) {
                    select.append(`<option value="${usuario.usuarioId}">${usuario.nombreUsuario}</option>`);
                });

                if (coincidencias.some(function (usuario) { return usuario.usuarioId.toString() === valorActual; })) {
                    select.val(valorActual);
                }
            }

            function cargarUsuarios() {
                fetchWithToken('/api/Usuarios/Listar')
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error('No se pudo obtener la lista de usuarios.');
                        }

                        return response.json();
                    })
                    .then(function (data) {
                        usuarios = data || [];
                        renderUsuarios('');
                    })
                    .catch(function (error) {
                        console.error('Error al cargar usuarios:', error);
                        mostrarMensaje(false, 'No se pudo cargar la lista de usuarios.');
                    });
            }

            $('#busquedaUsuario').on('input', function () {
                renderUsuarios($(this).val());
            });

            $('#resetPasswordForm').on('submit', function (event) {
                event.preventDefault();

                const usuarioId = $('#usuarioId').val();
                const nuevaPassword = $('#nuevaPassword').val().trim();
                const confirmarPassword = $('#confirmarPassword').val().trim();

                if (!usuarioId) {
                    mostrarMensaje(false, 'Debe seleccionar un usuario.');
                    return;
                }

                if (nuevaPassword.length < 6) {
                    mostrarMensaje(false, 'La nueva contrasena debe tener al menos 6 caracteres.');
                    return;
                }

                if (nuevaPassword !== confirmarPassword) {
                    mostrarMensaje(false, 'La confirmacion de contrasena no coincide.');
                    return;
                }

                fetchWithToken('/api/Usuarios/ResetPassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        usuarioId: parseInt(usuarioId, 10),
                        nuevaPassword: nuevaPassword
                    })
                })
                    .then(function (response) {
                        return response.json().then(function (data) {
                            return {
                                ok: response.ok,
                                data: data
                            };
                        });
                    })
                    .then(function (result) {
                        mostrarMensaje(result.ok && result.data.success, result.data.message);

                        if (result.ok && result.data.success) {
                            $('#resetPasswordForm')[0].reset();
                            renderUsuarios('');
                        }
                    })
                    .catch(function (error) {
                        console.error('Error al actualizar contrasena:', error);
                        mostrarMensaje(false, 'No se pudo actualizar la contrasena.');
                    });
            });

            cargarUsuarios();
        });
    </script>
}
